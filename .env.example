# HAKHAM Infinity
# Copie para .env apenas no ambiente local. Nunca versione credenciais reais.

HAKHAM_ENV=development
HAKHAM_LOG_LEVEL=INFO

# Active model provider: omniroute, ollama, openai or abacus
# Recommended everyday mode in v0.20: omniroute
HAKHAM_MODEL_PROVIDER=omniroute
# Optional. Empty means provider default: auto for OmniRoute, llama3.2 for Ollama, route-llm for Abacus.
HAKHAM_MODEL=

# OmniRoute local-first economy engine
# Fresh local installs can work without OMNIROUTE_API_KEY. If Dashboard > Endpoints gives you a key, use it here.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# auto = balanced zero-config routing. You can later try auto/cheap, auto/fast or auto/coding.
OMNIROUTE_MODEL=auto
# Optional per-request compression mode. Leave blank first; tune only after the gateway is stable.
OMNIROUTE_COMPRESSION=

# OpenAI
# Used by Hakham's natural GPT voice. Vision uses OpenAI only when explicitly selected
# or when HAKHAM_VISION_ALLOW_OPENAI_FALLBACK=true.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_SPEED=1.05
# Optional. Leave empty to use Hakham's built-in voice direction.
OPENAI_TTS_INSTRUCTIONS=
# OpenAI visual model, used only for explicit/openai fallback mode.
HAKHAM_VISION_MODEL=gpt-5.6-luna
HAKHAM_VISUAL_MEMORY_DIR=data/visual_memory

# Gemini
# Search prefers Gemini Google Search grounding whenever GEMINI_API_KEY is configured.
# Vision auto-order: Gemini -> Abacus RouteLLM. OpenAI is opt-in fallback.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# auto, gemini, abacus or openai
HAKHAM_VISION_PROVIDER=auto
HAKHAM_GEMINI_VISION_MODEL=gemini-3.8-flash
HAKHAM_ABACUS_VISION_MODEL=route-llm
# false avoids spending OpenAI vision credits when Gemini/Abacus fail.
HAKHAM_VISION_ALLOW_OPENAI_FALLBACK=false
# auto = Gemini Google Search first, then Abacus/DuckDuckGo fallbacks.
HAKHAM_WEB_PROVIDER=auto
HAKHAM_GEMINI_SEARCH_MODEL=gemini-3.8-flash

# Abacus.AI RouteLLM
# Premium sidecar in v0.20: kept available for explicit ASTRA/CONSELHO use, not everyday fuel.
# Never commit a real key.
ABACUS_ROUTELLM_API_KEY=
ABACUS_ROUTELLM_BASE_URL=https://routellm.abacus.ai/v1
# Optional Council Mode. Use exact IDs returned by GET /v1/models.
HAKHAM_COUNCIL_MODELS=
HAKHAM_COUNCIL_SYNTHESIS_MODEL=route-llm

# Public web research
# Gemini Google Search grounding is preferred when GEMINI_API_KEY is configured.
# If Gemini is unavailable, Hakham preserves Abacus Web Search and public DuckDuckGo fallback.
ABACUS_WEB_SEARCH_API_KEY=
ABACUS_WEB_SEARCH_URL=https://api.abacus.ai/api/searchWebForLLM
HAKHAM_WEB_MAX_RESULTS=7
HAKHAM_WEB_MAX_CONTEXT_CHARS=18000
HAKHAM_WEB_CACHE_SECONDS=300

# Ollama/local fallback
OLLAMA_BASE_URL=http://localhost:11434

# Memory
HAKHAM_MEMORY_DB=data/hakham.db

# Gateway
HAKHAM_HOST=127.0.0.1
HAKHAM_PORT=8765

# Voice
HAKHAM_VOICE_ENABLED=false
HAKHAM_WAKE_WORD=hakham

# Avatar/UI
HAKHAM_AVATAR_FILE=
HAKHAM_AVATAR_URL=

# Legacy/alternate web-search provider slots.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# External integrations
# ---------------------------------------------------------------------------

# 1. WhatsApp / Evolution API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# 2. Google Drive v3 READ ONLY
GOOGLE_DRIVE_ROOT_FOLDER_ID=1nsRNUkNtCEM4BiFJ4xVgQXg65dNiE4vU
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
